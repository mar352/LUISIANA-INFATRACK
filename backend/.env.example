# ── LUISIANA INFA-TRACK BACKEND ENVIRONMENT ──
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=luisiana_infatrack

# ── TEXTBEE.DEV SMS GATEWAY & COST CONTROL ──
# API key from your textbee.dev dashboard (leaves in simulation mode if empty)
TEXTBEE_API_KEY=
# Optional specific device ID (uses your default connected device if omitted)
TEXTBEE_DEVICE_ID=
TEXTBEE_ENABLED=true
# Max SMS sent system-wide per day (prevents carrier quota drain)
TEXTBEE_DAILY_LIMIT=100
# Max SMS sent to the same applicant per hour
TEXTBEE_RECIPIENT_HOURLY_LIMIT=3
# Cooldown gap in seconds between consecutive SMS to the same phone
TEXTBEE_COOLDOWN_SECONDS=120

