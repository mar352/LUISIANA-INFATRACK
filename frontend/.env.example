VITE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# Stadia Maps (basemap). Optional on localhost; required for production / non-local hosts.
# https://docs.stadiamaps.com/authentication/
VITE_STADIA_API_KEY=

# Local Vite (npm run dev): point at the backend
VITE_BACKEND_URL=http://localhost:4000

# Docker builds use the root .env and leave VITE_BACKEND_URL empty
# so the browser talks to the same origin (nginx proxies /api + /socket.io).

