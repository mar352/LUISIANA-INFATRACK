rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Password hashes and sessions live on the Express server, not here.
    match /accounts/{document=**} {
      allow read, write: if false;
    }
    match /sessions/{document=**} {
      allow read, write: if false;
    }
    // Staff may append an Activity line; deletion allowed for 24-hour retention purge.
    match /auditLogs/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }
    // Map pins: public read for the citizen globe. Full writes stay on /api/projects.
    // The Android field app may only append photos (and the matching timestamps).
    match /projects/{projectId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["photos", "updatedAt", "activityLog"]);
    }
    // Planning board still uses the client until those APIs move to Express.
    match /proposals/{document=**} {
      allow read, write: if true;
    }
    match /planningEvents/{document=**} {
      allow read, write: if true;
    }
    match /planningMeetings/{document=**} {
      allow read, write: if true;
    }
    match /documents/{document=**} {
      allow read, write: if true;
    }
    match /systemBackups/{document=**} {
      allow read, write: if true;
    }
    match /documentBackups/{document=**} {
      allow read, write: if true;
    }
  }
}
