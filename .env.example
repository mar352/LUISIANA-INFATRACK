# Copy to .env before: docker compose up --build
# Get a free token at https://account.mapbox.com/

VITE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# MapTiler (Satellite, Streets basemap, 3D Quantized-Mesh Terrain)
# https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=

# Stadia Maps basemap & satellite (fallback)
# https://docs.stadiamaps.com/authentication/
VITE_STADIA_API_KEY=

# Port the app is exposed on (open http://localhost:8080)
APP_PORT=8080

# Must match how you open the app in the browser (CORS)
CLIENT_ORIGIN=http://localhost:8080
